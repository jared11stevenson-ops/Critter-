; Engine configuration file.
; CRITTER — The Red Span Survey (vertical slice)

config_version=5

[application]

config/name="CRITTER"
config/description="CRITTER — The Red Span Survey. A Handler's first descent into the Red Reaches."
config/version="0.7.0"
run/main_scene="res://game/boot/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.07, 0.06, 0.06, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Events="*res://game/core/events.gd"
Canon="*res://game/core/canon.gd"
GameState="*res://game/core/game_state.gd"
Audio="*res://game/core/audio.gd"
Router="*res://game/core/router.gd"
Quality="*res://game/core/quality.gd"
QA="*res://tools/qa/qa.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=24.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.07, 0.06, 0.06, 1)
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1

[shader_globals]

critter_focus_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
critter_cam_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
