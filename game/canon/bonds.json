{
  "_doc": "Bond Contracts: how a sapient character is acquired. Each bond is a staged, character-specific trust quest built around their contradiction (Agent 3 authors the rest of the cast; Lead validates). 'requires' maps a stage to a spec (see design/LEDGER_SPEC.md). Empty requirement = advanced manually by gameplay (Ledger.set_bond). A bond never silently disappears: failing a test sends the character to 'estranged', with an optional 'reconcile_if'. Agent 3 round 2: estrange_if always carries a 'not amends' guard so a reconcile (event type 'amends' targeting the character) does not flip-flop; see DATA_REQUESTS.md. 'stage_hints' (extra key) are one-line UI hints per stage.",
  "zephyr": {
    "contradiction": "Treats rules as games but treats promises as sacred.",
    "stages": [
      "unmet",
      "met",
      "interested",
      "tested",
      "bonded"
    ],
    "requires": {
      "met": {
        "event": {
          "type": "talked",
          "target": "zephyr"
        }
      },
      "interested": {
        "promise": {
          "id": "zephyr_bring_both_home",
          "status_in": [
            "open",
            "kept",
            "loophole",
            "bent"
          ]
        }
      },
      "tested": {
        "promise": {
          "id": "zephyr_bring_both_home",
          "status_in": [
            "kept",
            "loophole",
            "bent"
          ]
        }
      },
      "bonded": {
        "all": [
          {
            "promise": {
              "id": "zephyr_bring_both_home",
              "status_in": [
                "kept",
                "loophole"
              ]
            }
          },
          {
            "opinion_min": {
              "character": "zephyr",
              "min": 3
            }
          }
        ]
      }
    },
    "estrange_if": {
      "all": [
        {
          "promise": {
            "id": "zephyr_bring_both_home",
            "status_in": [
              "broken"
            ]
          }
        },
        {
          "not": {
            "event": {
              "type": "promised",
              "target": "zephyr",
              "count_min": 2
            }
          }
        }
      ]
    },
    "reconcile_if": {
      "event": {
        "type": "promised",
        "target": "zephyr",
        "count_min": 2
      }
    },
    "reconcile_to": "interested",
    "test_hint": "Zephyr wants a promise, worded carefully. Wording is the whole art.",
    "stage_hints": {
      "met": "Talk to Zephyr in the Common.",
      "interested": "Make a promise, worded carefully.",
      "tested": "Keep it, to the letter or the spirit.",
      "bonded": "Keep it well enough that Zephyr says so."
    }
  },
