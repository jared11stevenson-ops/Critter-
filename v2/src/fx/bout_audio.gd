class_name BoutAudio
extends Node
## Plays procedural SFX (v2/audio/sfx/*.ogg, generated by tools/gen/gen_sfx.py) from sim events.
## Per-ability sounds are keyed by the move id; everything else falls back to the generic event sound.
## Attach with `BoutAudio.new()` + `bind(bout_scene)`.

const DIR := "res://audio/sfx/"
const VOICES := 14
var _players: Array[AudioStreamPlayer] = []
var _next := 0
var _cache: Dictionary = {}
var _bout: Node
var _hb_t := 0.0
var _amb: AudioStreamPlayer
var volume_db := -2.0
var _last_play: Dictionary = {}   # key -> msec, to avoid machine-gunning identical sounds

func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for i in VOICES:
		var p := AudioStreamPlayer.new()
		p.bus = &"Master"
		add_child(p)
		_players.append(p)

func bind(bout: Node) -> void:
	_bout = bout
	bout.fight_event.connect(_on_event)
	var ma: float = float(Settings.get_value("master_volume"))
	AudioServer.set_bus_volume_db(0, linear_to_db(clampf(ma, 0.001, 1.0)))
	play("bell_start")
	_amb = AudioStreamPlayer.new()
	add_child(_amb)
	var s: AudioStream = _stream("amb_arena")
	if s:
		(s as AudioStreamOggVorbis).loop = true
		_amb.stream = s
		_amb.volume_db = -14.0
		_amb.play()

func _stream(key: String) -> AudioStream:
	if _cache.has(key):
		return _cache[key]
	var path := DIR + key + ".ogg"
	var s: AudioStream = load(path) if ResourceLoader.exists(path) else null
	_cache[key] = s
	return s

func has_sound(key: String) -> bool:
	return _stream(key) != null

func play(key: String, vol_db := 0.0, pitch := 1.0, jitter := 0.06) -> void:
	var s := _stream(key)
	if s == null:
		return
	var now := Time.get_ticks_msec()
	if now - int(_last_play.get(key, -1000)) < 45:
		return
	_last_play[key] = now
	var p := _players[_next]
	_next = (_next + 1) % VOICES
	p.stream = s
	p.volume_db = volume_db + vol_db
	p.pitch_scale = pitch * (1.0 + randf_range(-jitter, jitter))
	p.play()

func _on_event(ev: Dictionary) -> void:
	var t := str(ev.get("type", ""))
	var mid := str(ev.get("move_id", ""))
	var kind := str(ev.get("kind", ""))
	match t:
		"tell":
			if has_sound(mid) and (kind == "ability" or kind == "laststand" or kind == "dodge"):
				play(mid, 0.0, 1.0, 0.03)
			elif _ability_sound(mid) != "" and kind != "light":
				play(_ability_sound(mid), -2.0)
			elif kind == "heavy":
				play("swing_heavy")
				play("tell_heavy", -6.0)
			elif kind == "light":
				play("swing_light", -4.0)
			elif kind == "dodge":
				play("dodge")
		"hit":
			var dmg := float(ev.get("damage", 0.0))
			if bool(ev.get("counter", false)) or dmg >= 24.0:
				play("hit_crit")
			elif dmg >= 12.0:
				play("hit_heavy")
			else:
				play("hit_light", 0.0, 1.0 + clampf(dmg, 0.0, 12.0) * -0.01)
		"block":
			play("block")
		"parry":
			play("parry")
		"clash":
			play("clash")
		"grab":
			play("grab")
		"dodge":
			play("dodge", -3.0)
		"stagger":
			play("stagger", -4.0)
		"ko":
			play("ko")
		"ringout":
			play("ringout")
		"laststand":
			play("last_stand")
		"yield":
			play("yield")
		"compel":
			play("cigarra_puppet_thought", -4.0)
		"ghost":
			play("cigarra_premonition", -6.0)
		"gust":
			play("zephyr_gust", -3.0)
		"trap":
			play("bramvex_ground_prep", -4.0)
		"ripe":
			play("scarlith_aged_to_perfection", -8.0, 1.3)
		"zone", "summon", "stance", "projectile", "teleport", "hazard", "shatter", "morrow_first", "rage", "plate":
			var snd := _ability_sound(mid)
			if snd != "":
				play(snd, -5.0, 1.1)
			elif t == "shatter" or t == "plate":
				play("hit_heavy", -4.0)

## a move id like aruun_reaching_strike3 or bramvex_diplomacy2 maps to the nearest sound key
func _ability_sound(mid: String) -> String:
	if mid == "":
		return ""
	if has_sound(mid):
		return mid
	var base := mid
	while base.length() > 0 and base[base.length() - 1].is_valid_int():
		base = base.substr(0, base.length() - 1)
	if has_sound(base):
		return base
	return ""

func _process(delta: float) -> void:
	if _bout == null or not is_instance_valid(_bout) or not ("sim" in _bout) or _bout.sim == null:
		return
	var pi: int = int(_bout.player_idx) if "player_idx" in _bout else 0
	if pi < 0:
		return
	var f: Dictionary = _bout.sim.state()["fighters"][pi]
	var r := float(f["vitality"]) / maxf(1.0, float(f["vitality_max"]))
	if f["alive"] and r < 0.25:
		_hb_t -= delta
		if _hb_t <= 0.0:
			play("heartbeat", -3.0, 1.0 + (0.25 - r) * 1.6)
			_hb_t = 0.9 - (0.25 - r) * 1.6
