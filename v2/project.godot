; Engine configuration file.
; CRITTER v2 — high-stakes critter duels (see design/v2/GDD.md)

config_version=5

[application]

config/name="CRITTER 2"
config/description="Capture it. Raise it. Fight with it. Keep it alive."
config/version="0.2.0"
run/main_scene="res://src/boot/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.07, 0.06, 0.06, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Events="*res://src/core/events.gd"
Settings="*res://src/core/settings.gd"
InputActions="*res://src/core/input_actions.gd"
Perf="*res://src/core/perf.gd"
GameSave="*res://src/core/save_service.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.07, 0.06, 0.06, 1)
